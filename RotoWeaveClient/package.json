{
  "name": "rotoweave-client",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app tests vite.config.ts",
    "build": "npm run typecheck && vite build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest backend/tests -q"
  },
  "dependencies": {
    "@rotoweave/contracts": "file:../RotoWeaveContracts",
    "@tanstack/react-query": "^5.101.4",
    "konva": "^10.3.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-konva": "^19.2.5",
    "use-image": "^1.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "8.2.0"
  }
}
